# syntax=docker/dockerfile:1

ARG PHP_VERSION=8.4.28
FROM php:${PHP_VERSION}-apache-bookworm
ENV DEBIAN_FRONTEND=noninteractive \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/composer \
    COMPOSER_MAX_PARALLEL_HTTP=24 \
    PHP_DATE_TIMEZONE=UTC \
    PHP_DISPLAY_ERRORS=Off \
    PHP_ERROR_REPORTING=22527 \
    PHP_MEMORY_LIMIT=256M \
    PHP_MAX_EXECUTION_TIME=90 \
    PHP_POST_MAX_SIZE=100M \
    PHP_UPLOAD_MAX_FILE_SIZE=100M \
    PHP_ALLOW_URL_FOPEN=Off \
    QA_SERVER=apache-mod-php \
    AIKIDO_BLOCKING=true \
    AIKIDO_BLOCK=true \
    AIKIDO_DISK_LOGS=true \
    AIKIDO_DEBUG=true

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
        sqlite3 cron python3-flask procps tini libpq-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql pgsql \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && a2enmod rewrite headers \
    && rm /var/log/apache2/access.log /var/log/apache2/error.log /var/log/apache2/other_vhosts_access.log \
    && a2dissite 000-default \
    && echo "ServerName localhost" >> /etc/apache2/apache2.conf \
    && rm -rf /var/lib/apt/lists/*

COPY .qa-control-tests/apache-mod-php/apache.conf /etc/apache2/sites-available/laravel.conf
COPY .qa-control-tests/apache-mod-php/ports.conf /etc/apache2/ports.conf
COPY .qa-control-tests/common/control_server.py /usr/local/bin/control-server
COPY .qa-control-tests/common/entrypoint.sh /qa-entrypoint
RUN chmod 755 /usr/local/bin/control-server /qa-entrypoint \
    && a2ensite laravel

COPY . /var/www/html
# The shared UI consists of static files; copy its assets directly.
COPY resources/public/ /var/www/html/public/
WORKDIR /var/www/html

RUN composer install --optimize-autoloader --no-dev \
    && mkdir -p storage/logs \
    && chown -R www-data:www-data /var/www/html \
    && echo "MAILTO=\"\"\n* * * * * www-data /usr/local/bin/php /var/www/html/artisan schedule:run" > /etc/cron.d/laravel \
    && sed -i='' '/->withMiddleware(function (Middleware \$middleware) {/a\
        \$middleware->trustProxies(at: "*");\
    ' bootstrap/app.php; \
    rm -rf /var/www/html/.qa-control-tests

EXPOSE 8080 8081
ENTRYPOINT ["/usr/bin/tini", "--", "/qa-entrypoint"]
