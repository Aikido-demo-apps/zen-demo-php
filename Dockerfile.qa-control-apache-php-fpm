# syntax=docker/dockerfile:1

FROM ubuntu:22.04 AS app

ARG PHP_VERSION=8.4.27
ARG PHP_SERIES=8.4
ENV DEBIAN_FRONTEND=noninteractive \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/composer \
    COMPOSER_MAX_PARALLEL_HTTP=24 \
    PHP_PM_MAX_CHILDREN=5 \
    PHP_PM_START_SERVERS=2 \
    PHP_MIN_SPARE_SERVERS=1 \
    PHP_MAX_SPARE_SERVERS=3 \
    PHP_DATE_TIMEZONE=UTC \
    PHP_DISPLAY_ERRORS=Off \
    PHP_ERROR_REPORTING=22527 \
    PHP_MEMORY_LIMIT=256M \
    PHP_MAX_EXECUTION_TIME=90 \
    PHP_POST_MAX_SIZE=100M \
    PHP_UPLOAD_MAX_FILE_SIZE=100M \
    PHP_ALLOW_URL_FOPEN=Off \
    QA_SERVER=apache-php-fpm \
    QA_PHP_VERSION=${PHP_SERIES} \
    AIKIDO_BLOCKING=true \
    AIKIDO_BLOCK=true \
    AIKIDO_DISK_LOGS=true \
    AIKIDO_DEBUG=true

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY .fly/php/ondrej_ubuntu_php.gpg /etc/apt/trusted.gpg.d/ondrej_ubuntu_php.gpg

RUN apt-get update \
    && apt-get install -y --no-install-recommends gnupg2 ca-certificates git-core curl zip unzip \
        rsync vim-tiny htop sqlite3 apache2 cron python3-flask procps tini \
    && ln -sf /usr/bin/vim.tiny /etc/alternatives/vim \
    && ln -sf /etc/alternatives/vim /usr/bin/vim \
    && echo "deb http://ppa.launchpad.net/ondrej/php/ubuntu jammy main" > /etc/apt/sources.list.d/ondrej-ubuntu-php-focal.list \
    && apt-get update \
    && apt-get -y --no-install-recommends install \
        php${PHP_SERIES}-bcmath \
        php${PHP_SERIES}-cli \
        "php${PHP_SERIES}-common=${PHP_VERSION}-*" \
        php${PHP_SERIES}-curl \
        php${PHP_SERIES}-gd \
        php${PHP_SERIES}-intl \
        php${PHP_SERIES}-mbstring \
        php${PHP_SERIES}-mysql \
        php${PHP_SERIES}-pgsql \
        php${PHP_SERIES}-redis \
        php${PHP_SERIES}-soap \
        php${PHP_SERIES}-sqlite3 \
        php${PHP_SERIES}-xml \
        php${PHP_SERIES}-zip \
        php${PHP_SERIES}-swoole \
        php${PHP_SERIES}-fpm \
    && a2enmod rewrite headers proxy proxy_fcgi setenvif \
    && a2dissite 000-default \
    && mkdir -p /var/www/html/public \
    && echo "index" > /var/www/html/public/index.php \
    && echo "ServerName localhost" >> /etc/apache2/apache2.conf \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/*

COPY .fly/fpm/ /etc/php/${PHP_SERIES}/fpm/
COPY .qa-control-tests/apache-php-fpm/apache.conf /etc/apache2/sites-available/laravel.conf
COPY .qa-control-tests/apache-php-fpm/ports.conf /etc/apache2/ports.conf
COPY .qa-control-tests/common/control_server.py /usr/local/bin/control-server
COPY .qa-control-tests/common/entrypoint.sh /qa-entrypoint
RUN chmod 755 /usr/local/bin/control-server /qa-entrypoint \
    && a2ensite laravel \
    && sed -i 's/^daemonize = no/daemonize = yes/' /etc/php/${PHP_SERIES}/fpm/pool.d/www.conf \
    && sed -i "s|^error_log = /proc/self/fd/2|error_log = /var/log/php${PHP_SERIES}-fpm.log|" /etc/php/${PHP_SERIES}/fpm/pool.d/www.conf \
    && sed -i "/^\[global\]/a pid = /run/php/php${PHP_SERIES}-fpm.pid" /etc/php/${PHP_SERIES}/fpm/pool.d/www.conf

COPY . /var/www/html
# The shared UI consists of static files; copy its assets directly.
COPY resources/public/ /var/www/html/public/
WORKDIR /var/www/html

RUN composer install --optimize-autoloader --no-dev \
    && mkdir -p storage/logs \
    && chown -R www-data:www-data /var/www/html \
    && echo "MAILTO=\"\"\n* * * * * www-data /usr/bin/php /var/www/html/artisan schedule:run" > /etc/cron.d/laravel \
    && sed -i='' '/->withMiddleware(function (Middleware \$middleware) {/a\
        \$middleware->trustProxies(at: "*");\
    ' bootstrap/app.php; \
    rm -rf /var/www/html/.qa-control-tests

EXPOSE 8080 8081
ENTRYPOINT ["/usr/bin/tini", "--", "/qa-entrypoint"]
